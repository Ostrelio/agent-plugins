{
  "name": "@ostrelio/agent-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tool-call classifier, Ostrelio client, session ledger and reviewer CLI for harness plugins.",
  "type": "module",
  "bin": {
    "ostrelio": "cli.ts"
  },
  "exports": {
    "./classify": "./classify.ts",
    "./client": "./client.ts",
    "./ledger": "./ledger.ts",
    "./reviewer": "./reviewer.ts"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types classify.test.ts ledger.test.ts reviewer.test.ts",
    "policies": "node install-policies.mjs"
  },
  "engines": { "node": ">=22.13" }
}
