{
  "name": "@ostrelio/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Ostrelio agent authorization API.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example": "npm run build && node --experimental-strip-types examples/approval-demo.ts",
    "example:tools": "npm run build && node --experimental-strip-types examples/wrap-tools-demo.ts",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
